+def _claim_identity(record: dict) -> bool:
+    """Bind this process to the record, claiming an unset identity.
+
+    A launcher that spawns the supervisor records the PID itself; a host that
+    supervises the run inside its own process leaves it unset. In both cases the
+    identity is written under the directory lock, and an identity that is
+    already someone else's is never overwritten.
+    """
+    here = os.getpid()
+    created = psutil.Process(here).create_time()
+    pid = record.get("pid")
+    if pid is None:
+        record["pid"] = here
+        record["process_created"] = created
+        return True
+    if int(pid) != here:
+        return False
+    recorded = record.get("process_created")
+    if recorded is None:
+        record["process_created"] = created
+        return True
+    return abs(created - float(recorded)) < 0.01
+
+
+def _record_not_started(directory: Path, record: dict) -> None:
+    """State positively that a stop arrived before any research could run.
+
+    This is the only positive pre-research fact: a missing ``running`` write or
+    a missing readiness file is not evidence that nothing started.
