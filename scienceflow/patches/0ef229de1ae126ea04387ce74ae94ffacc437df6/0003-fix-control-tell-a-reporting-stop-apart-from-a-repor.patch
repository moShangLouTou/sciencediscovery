From d6d4b77f93061ced9ae3e3d8c10c0f70f28113a9 Mon Sep 17 00:00:00 2001
From: liyuan <liyuan390@huawei.com>
Date: Sat, 14 Nov 2026 19:58:30 +0800
Subject: [PATCH 3/3] fix(control): tell a reporting stop apart from a report
 timeout

finalize_reports swallowed CancelledError together with TimeoutError, so a
stop consumed while reports were generating returned as an ordinary timeout:
the supervisor's own cancellation branch was unreachable, and a run whose
research completed was recorded as failed with a generation failure.

The report process group is still reaped first. The supervisor now asks for
the cancellation to be re-raised (`raise_on_cancel=True`) so it can record
`report_status="incomplete"` while keeping the research outcome; a caller that
owns no supervisor state keeps the historical result contract, and a report
timeout, its SIGALRM deadline and a non-zero generator keep their own
semantics. The report generator stays a module seam so a test can replace
exactly that child process and keep the real wait, deadline, cancellation and
cleanup.
---
 .../parallel/control/reporting/__init__.py    |  32 ++-
 .../runtime/parallel/control/worker.py        |   5 +-
 tests/test_managed_lifecycle.py               | 196 +++++++++++++++++-
 3 files changed, 220 insertions(+), 13 deletions(-)

diff --git a/scienceflow/runtime/parallel/control/reporting/__init__.py b/scienceflow/runtime/parallel/control/reporting/__init__.py
index c7e5c71..6bbe89d 100644
--- a/scienceflow/runtime/parallel/control/reporting/__init__.py
+++ b/scienceflow/runtime/parallel/control/reporting/__init__.py
@@ -8,6 +8,12 @@ import os
 import signal
 import sys
 
+# The report generator itself is an expensive boundary of the engine, not the
+# lifecycle this module owns. It stays a module attribute so a test can replace
+# exactly that child process while the wait, the deadline, the cancellation and
+# the cleanup below remain the production ones.
+spawn_report_process = asyncio.create_subprocess_exec
+
 
 def report_budget(payload: dict) -> float:
     value = payload.get("report_budget_sec", 300)
@@ -22,10 +28,22 @@ def report_budget(payload: dict) -> float:
     return budget
 
 
-async def finalize_reports(record: dict) -> tuple[list[dict], bool]:
-    """Reap the report process at its own deadline; inspect committed files."""
+async def finalize_reports(
+    record: dict, *, raise_on_cancel: bool = False
+) -> tuple[list[dict], bool]:
+    """Reap the report process at its own deadline; inspect committed files.
+
+    A cancellation (the host stopped this attempt while reports were being
+    written) is reaped before it is reported, so no report process outlives the
+    attempt. The supervisor asks for it to be re-raised
+    (``raise_on_cancel=True``) because "stopped" and "timed out" are different
+    facts: a canceled report keeps the research outcome and is recorded as
+    incomplete. The default keeps the historical standalone contract — a
+    canceled report is an interrupted report — for callers that own no
+    supervisor state.
+    """
     budget = report_budget(record.get("manifest_payload") or {})
-    process = await asyncio.create_subprocess_exec(
+    process = await spawn_report_process(
         sys.executable,
         "-m",
         __name__,
@@ -40,7 +58,13 @@ async def finalize_reports(record: dict) -> tuple[list[dict], bool]:
     try:
         await asyncio.wait_for(process.wait(), timeout=budget)
         timed_out = process.returncode == -signal.SIGALRM
-    except (TimeoutError, asyncio.CancelledError):
+    except asyncio.CancelledError:
+        # Reaped in the ``finally`` below, then re-raised: "stopped" and "timed
+        # out" are different facts and must not be collapsed here.
+        if raise_on_cancel:
+            raise
+        timed_out = True
+    except TimeoutError:
         timed_out = True
     finally:
         if process.returncode is None:
diff --git a/scienceflow/runtime/parallel/control/worker.py b/scienceflow/runtime/parallel/control/worker.py
index 3e8a723..89ebcca 100644
--- a/scienceflow/runtime/parallel/control/worker.py
+++ b/scienceflow/runtime/parallel/control/worker.py
@@ -233,7 +233,10 @@ async def supervise(
         )
         report_cancelled = False
         try:
-            reports, timed_out = await finalize_reports(record)
+            # The supervisor asks the real finalizer for the distinction it
+            # needs: a cancelled report is re-raised after its process group is
+            # reaped, while its own timeout stays an ordinary result.
+            reports, timed_out = await finalize_reports(record, raise_on_cancel=True)
         except asyncio.CancelledError:
             # A stop consumed while reports are generating keeps the research
             # outcome already stated and records the report as incomplete. It
