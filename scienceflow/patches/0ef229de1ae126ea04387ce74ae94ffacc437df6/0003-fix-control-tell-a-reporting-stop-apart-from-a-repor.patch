+    async def test_a_real_report_stop_is_incomplete_not_a_failure(self) -> None:
+        """E4 over the real finalizer: a stop keeps completed research.
+
+        Only the expensive report generator is replaced, by a real long-running
+        child in its own session. The wait, the cancellation, the process-group
+        kill and the await that reaps it are ``finalize_reports``' own code, so
+        this is the behaviour the bridge's stop actually meets.
+        """
+        prepared = self._prepare("report-real-stop", manifest_payload={"report_budget_sec": 30})
+        stop_event = asyncio.Event()
+        spawned: list[asyncio.subprocess.Process] = []
+        started = asyncio.Event()
+
+        async def fake_spawn(*_args, **_kwargs):
+            process = await asyncio.create_subprocess_exec(
+                "/bin/sleep", "30",
+                stdin=asyncio.subprocess.DEVNULL,
+                start_new_session=True,
+            )
+            spawned.append(process)
+            started.set()
+            return process
+
+        async def research(manifest: str):
+            return _Summary()
+
+        async def stop_later():
+            await started.wait()
+            stop_event.set()
+
+        reports = types.ModuleType("scienceflow.research.reporting")
+        reports.read_report_manifest = lambda root: None
+        starter = asyncio.create_task(stop_later())
+        with mock.patch.dict(sys.modules, {"scienceflow.research.reporting": reports}), \
+                mock.patch(
+                    "scienceflow.runtime.parallel.control.reporting.spawn_report_process",
+                    fake_spawn,
+                ):
+            await worker.supervise(
+                "report-real-stop", prepared.launch_token, stop_event=stop_event, research=research,
+            )
+        await starter
+        record = read_record(run_dir("report-real-stop"))
+        self.assertEqual(record["research_status"], "completed")
+        self.assertEqual(record["report_status"], "incomplete")
+        self.assertEqual(record["status"], "completed")
+        self.assertEqual(record["phase"], "finished")
+        self.assertFalse(record["report_timed_out"])
+        # The report process was reaped before the record was written, so no
+        # generator outlives the attempt it belonged to.
+        self.assertEqual(len(spawned), 1)
+        self.assertIsNotNone(spawned[0].returncode)
+        with self.assertRaises(ProcessLookupError):
+            os.kill(spawned[0].pid, 0)
+
+    async def test_a_real_report_timeout_still_fails_generation(self) -> None:
+        """A report that spends its own budget is a timeout, not a stop."""
+        prepared = self._prepare("report-real-timeout", manifest_payload={"report_budget_sec": 0.05})
+        spawned: list[asyncio.subprocess.Process] = []
+
+        async def fake_spawn(*_args, **_kwargs):
+            process = await asyncio.create_subprocess_exec(
+                "/bin/sleep", "30",
+                stdin=asyncio.subprocess.DEVNULL,
+                start_new_session=True,
+            )
+            spawned.append(process)
+            return process
+
+        async def research(manifest: str):
+            return _Summary()
+
+        reports = types.ModuleType("scienceflow.research.reporting")
+        reports.read_report_manifest = lambda root: None
+        with mock.patch.dict(sys.modules, {"scienceflow.research.reporting": reports}), \
+                mock.patch(
+                    "scienceflow.runtime.parallel.control.reporting.spawn_report_process",
+                    fake_spawn,
+                ):
+            await worker.supervise("report-real-timeout", prepared.launch_token, research=research)
+        record = read_record(run_dir("report-real-timeout"))
+        self.assertEqual(record["research_status"], "completed")
+        self.assertEqual(record["report_status"], "generation_failed")
+        self.assertEqual(record["status"], "failed")
+        self.assertTrue(record["report_timed_out"])
+        self.assertEqual(len(spawned), 1)
+        self.assertIsNotNone(spawned[0].returncode)
+
+    async def test_a_real_report_child_failure_keeps_its_own_semantics(self) -> None:
+        """A generator that exits non-zero is a failed report, not a stop."""
+        prepared = self._prepare("report-real-failed")
+        spawned: list[asyncio.subprocess.Process] = []
+
+        async def fake_spawn(*_args, **_kwargs):
+            process = await asyncio.create_subprocess_exec(
+                "/bin/sh", "-c", "exit 1",
+                stdin=asyncio.subprocess.DEVNULL,
+                start_new_session=True,
+            )
+            spawned.append(process)
+            return process
+
+        async def research(manifest: str):
+            return _Summary()
+
+        reports = types.ModuleType("scienceflow.research.reporting")
+        reports.read_report_manifest = lambda root: None
+        with mock.patch.dict(sys.modules, {"scienceflow.research.reporting": reports}), \
+                mock.patch(
+                    "scienceflow.runtime.parallel.control.reporting.spawn_report_process",
+                    fake_spawn,
+                ):
+            await worker.supervise("report-real-failed", prepared.launch_token, research=research)
+        record = read_record(run_dir("report-real-failed"))
+        self.assertEqual(record["research_status"], "completed")
+        self.assertEqual(record["report_status"], "generation_failed")
+        self.assertEqual(record["status"], "failed")
+        self.assertFalse(record["report_timed_out"])
+        # A non-zero return code is not the report's SIGALRM deadline.
+        self.assertEqual(spawned[0].returncode, 1)
+
+    async def test_the_standalone_finalizer_keeps_its_cancel_contract(self) -> None:
+        """A direct caller still gets a result; only the supervisor raises.
+
+        ``worker.supervise`` asks for ``raise_on_cancel=True`` because it has a
+        record to finish. A caller that owns no supervisor state keeps the
+        historical contract: the report process is reaped and the call returns
+        ``timed_out=True`` instead of raising.
+        """
+        record = {
+            "attempt": 1,
+            "launch_token": "standalone-token",
+            "manifest_payload": {"report_budget_sec": 30},
+            "run_id": "standalone-report",
+            "task_roots": [],
+        }
+        spawned: list[asyncio.subprocess.Process] = []
+
+        async def fake_spawn(*_args, **_kwargs):
+            process = await asyncio.create_subprocess_exec(
+                "/bin/sleep", "30",
+                stdin=asyncio.subprocess.DEVNULL,
+                start_new_session=True,
+            )
+            spawned.append(process)
+            return process
+
+        reports = types.ModuleType("scienceflow.research.reporting")
+        reports.read_report_manifest = lambda root: None
+        with mock.patch.dict(sys.modules, {"scienceflow.research.reporting": reports}), \
+                mock.patch(
+                    "scienceflow.runtime.parallel.control.reporting.spawn_report_process",
+                    fake_spawn,
+                ):
+            pending = asyncio.create_task(reporting.finalize_reports(record))
+            await asyncio.sleep(0.05)
+            pending.cancel()
+            reports, timed_out = await pending
+        self.assertTrue(timed_out)
+        self.assertEqual(reports, [])
+        self.assertEqual(len(spawned), 1)
+        self.assertIsNotNone(spawned[0].returncode)
+
+    def test_the_report_budget_is_read_only_from_the_manifest_top_level(self) -> None:
+        """The contract the Runner derives a manifest for: one top-level key.
+
+        ``finalize_reports`` passes ``record["manifest_payload"]`` whole, so a
+        budget nested under ``defaults`` (or anywhere else) is silently ignored
+        and the 300 s default applies. A derived manifest must therefore put the
+        key at the top level.
+        """
+        self.assertEqual(report_budget({"report_budget_sec": 2}), 2.0)
+        self.assertEqual(report_budget({"report_budget_sec": 0.5}), 0.5)
+        self.assertEqual(report_budget({}), 300.0)
+        self.assertEqual(report_budget({"defaults": {"report_budget_sec": 2}}), 300.0)
+
     def test_the_public_entry_points_keep_their_shapes(self) -> None:
         self.assertTrue(callable(prepare_run))
         self.assertIsInstance(worker.run_manifest, type(None))
