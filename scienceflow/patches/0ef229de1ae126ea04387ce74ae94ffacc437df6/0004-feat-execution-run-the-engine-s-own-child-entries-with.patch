     argv = ParallelRunner.child_cli_argv(spec)
-    assert argv[1:4] == ["-m", "scienceflow.interfaces.cli", "prep"]
+    assert argv[1:5] == ["-P", "-m", "scienceflow.interfaces.cli", "prep"]
     assert argv[argv.index("--task") + 1] == "prepare objective"
 
 
